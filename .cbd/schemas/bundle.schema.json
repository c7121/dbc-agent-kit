{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle",
  "type": "object",
  "required": [
    "id",
    "status",
    "loop"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "done"
      ]
    },
    "loop": {
      "type": "array"
    }
  }
}
