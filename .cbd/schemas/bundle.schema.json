{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "status",
    "artifact_paths",
    "phases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "done"
      ]
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "task",
        "contract",
        "evidence_json"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "evidence_json": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "plan",
        "build"
      ],
      "properties": {
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "step",
              "status"
            ],
            "properties": {
              "step": {
                "type": "string",
                "enum": [
                  "draft_contract",
                  "clarify_rounds",
                  "set_ready"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "todo",
                  "done",
                  "blocked"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "build": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "owner",
              "description",
              "proves",
              "outputs",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "enum": [
                  "build",
                  "test",
                  "verify",
                  "review",
                  "docs",
                  "ops"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "proves": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "todo",
                  "in_progress",
                  "done",
                  "blocked",
                  "skipped"
                ]
              }
            }
          }
        }
      }
    }
  }
}